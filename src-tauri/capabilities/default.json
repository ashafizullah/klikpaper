{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window calls KlikPaper's own commands, file dialogs, opening links/folders, and window dragging.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:app:allow-version",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir"
  ]
}
