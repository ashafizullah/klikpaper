{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KlikPaper",
  "version": "0.1.5",
  "identifier": "com.ashafizullah.klikpaper",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KlikPaper",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#15130f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob:; font-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "msi", "deb", "rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "Free, open-source, lightweight PDF tool",
    "longDescription": "View, organize, compress, convert, annotate, sign and protect PDFs on your own computer, with optional AI chat using your own API key, and an MCP server for the AI agent you already use.",
    "copyright": "Copyright © 2026 Adam Suchi Hafizullah. MIT License.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "dmg": {
        "background": "installer/dmg-background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 210 },
        "applicationFolderPosition": { "x": 480, "y": 210 }
      }
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "publisher": "KlikPaper contributors",
    "homepage": "https://github.com/ashafizullah/klikpaper",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyNDE1NDAxNEFCMDA2QjMKUldTekJyQktBVlJCa21PQUQ1cnJsODdvTElDNTByNUdrUjlOc1l6MzVJdis4Q1loSTdvYUs2Z3QK",
      "endpoints": ["https://github.com/ashafizullah/klikpaper/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
